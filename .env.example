# รหัสแอดมิน (จำเป็นบน Vercel) ใช้เขียน/แก้ไข runbook และดูสถิติ
ADMIN_KEY=change-me

# ฐานข้อมูล: Upstash Redis (ติดตั้งจาก Vercel Marketplace แล้ว env จะมาเอง)
# ถ้าไม่ใส่ ตอนรันในเครื่องจะเก็บเป็นไฟล์ใน .data/
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ชื่อที่แสดงบนหน้าเว็บ
ORG_NAME=IT Helpdesk
# ลิงก์เปิด ticket (ระบบ helpdesk, Google Form หรือ LINE OA ของทีม IT)
TICKET_URL=
# ข้อความติดต่อ IT ที่แสดงท้ายหน้า
IT_CONTACT=โทร 1234 หรือ LINE: @it-support
